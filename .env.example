# Server-only secrets. Never prefix secret keys with NEXT_PUBLIC_.

# Claude — chatbot and personal face-reading summary (receives numbers only, never photos)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# FLUX.1 Kontext [dev] — open-weight image editing (Black Forest Labs) via Replicate. Default "after" model when set.
# Get a token at https://replicate.com/account/api-tokens (~$0.025 per image).
REPLICATE_API_TOKEN=

# Vercel AI Gateway — fallback "after" model and compare mode. On Vercel, OIDC is used automatically.
AI_GATEWAY_API_KEY=
# Leave empty for automatic: replicate/flux-kontext-dev if REPLICATE_API_TOKEN is set, else bytedance/seedream-4.0
SIMULATION_MODEL=
# Free-tier gateway credits only allow some models (seedream-4.0 is the default; kontext-pro also works). After a paid top-up you can try bfl/flux-3-image.
# Other editing models: bytedance/seedream-5.5 (~$0.02), bfl/flux-kontext-pro (~$0.04, older), bfl/flux-2-max

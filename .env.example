# Server-only secrets. Never prefix secret keys with NEXT_PUBLIC_.

# Claude — chatbot and personal face-reading summary (receives numbers only, never photos)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Vercel AI Gateway — "after" simulation images. On Vercel, OIDC is used automatically.
AI_GATEWAY_API_KEY=
# Default is bfl/flux-kontext-pro (FLUX Kontext Pro, ~$0.04 per image). Leave empty to use it.
SIMULATION_MODEL=

# Optional: FLUX.1 Kontext [dev] (open-weight) via Replicate, offered in compare mode (~$0.025 per image).
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Free-tier gateway credits only allow some models (seedream-4.0 is the default; kontext-pro also works). After a paid top-up you can try bfl/flux-3-image.
# Other editing models: bytedance/seedream-5.5 (~$0.02), bfl/flux-kontext-pro (~$0.04, older), bfl/flux-2-max
